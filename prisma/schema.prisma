// StockPulse database schema.
// Tables and columns use snake_case in PostgreSQL; raw SQL in services relies on these names.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum BranchRole {
  ADMIN
  MANAGER
  WAREHOUSE_WORKER
  SELLER
}

enum MovementType {
  IN
  SALE
  TRANSFER_IN
  TRANSFER_OUT
  ADJUSTMENT
  REVERSAL
}

enum MovementDirection {
  INCREASE
  DECREASE
}

enum TransferStatus {
  PENDING
  COMPLETED
  CANCELLED
}

model User {
  id           String   @id @default(uuid()) @db.Uuid
  name         String   @db.VarChar(120)
  email        String   @unique @db.VarChar(254)
  passwordHash String   @map("password_hash")
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  refreshTokens    RefreshToken[]
  memberships      BranchMembership[]
  movements        StockMovement[]
  createdTransfers StockTransfer[]    @relation("TransferCreatedBy")
  auditLogs        AuditLog[]
  notifications    Notification[]
  idempotencyKeys  IdempotencyKey[]

  @@map("users")
}

model RefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  // HMAC-SHA256 of the token secret. The raw token is never stored.
  tokenHash String    @map("token_hash") @db.VarChar(128)
  // All tokens produced by one login share a family; reuse of a rotated token revokes the family.
  familyId  String    @map("family_id") @db.Uuid
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
  @@map("refresh_tokens")
}

model Branch {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @unique @db.VarChar(120)
  address   String   @db.VarChar(255)
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  memberships          BranchMembership[]
  inventory            Inventory[]
  movements            StockMovement[]
  outgoingTransfers    StockTransfer[]    @relation("TransferSource")
  incomingTransfers    StockTransfer[]    @relation("TransferDestination")
  notifications        Notification[]

  @@map("branches")
}

model BranchMembership {
  id        String     @id @default(uuid()) @db.Uuid
  userId    String     @map("user_id") @db.Uuid
  branchId  String     @map("branch_id") @db.Uuid
  role      BranchRole
  createdAt DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  branch Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@unique([userId, branchId])
  @@index([branchId, role])
  @@map("branch_memberships")
}

model Category {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @unique @db.VarChar(120)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  products Product[]

  @@map("categories")
}

model Product {
  id          String   @id @default(uuid()) @db.Uuid
  sku         String   @unique @db.VarChar(64)
  name        String   @db.VarChar(200)
  description String?  @db.VarChar(2000)
  categoryId  String?  @map("category_id") @db.Uuid
  unit        String   @db.VarChar(32)
  price       Decimal  @db.Decimal(12, 2)
  minStock    Int      @default(0) @map("min_stock")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  category      Category?           @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  inventory     Inventory[]
  movements     StockMovement[]
  transferItems StockTransferItem[]

  @@index([categoryId])
  @@index([isActive, name])
  @@map("products")
}

model Inventory {
  id        String   @id @default(uuid()) @db.Uuid
  branchId  String   @map("branch_id") @db.Uuid
  productId String   @map("product_id") @db.Uuid
  quantity  Int      @default(0)
  // Incremented on every mutation; clients use it to order events and detect gaps.
  version   Int      @default(0)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  branch  Branch  @relation(fields: [branchId], references: [id], onDelete: Restrict)
  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@unique([branchId, productId])
  @@index([productId])
  @@map("inventory")
}

model StockMovement {
  id                 String            @id @default(uuid()) @db.Uuid
  productId          String            @map("product_id") @db.Uuid
  branchId           String            @map("branch_id") @db.Uuid
  type               MovementType
  direction          MovementDirection
  // Always positive; `direction` says whether stock went up or down.
  quantity           Int
  // Inventory quantity and version immediately after this movement was applied.
  balanceAfter       Int               @map("balance_after")
  inventoryVersion   Int               @map("inventory_version")
  // Transfer id for TRANSFER_IN / TRANSFER_OUT; original movement id for REVERSAL.
  referenceId        String?           @map("reference_id") @db.Uuid
  // Set only on REVERSAL movements; the unique constraint allows at most one reversal per movement.
  reversedMovementId String?           @unique @map("reversed_movement_id") @db.Uuid
  idempotencyKey     String?           @map("idempotency_key") @db.VarChar(128)
  createdBy          String            @map("created_by") @db.Uuid
  note               String?           @db.VarChar(500)
  createdAt          DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)

  product        Product        @relation(fields: [productId], references: [id], onDelete: Restrict)
  branch         Branch         @relation(fields: [branchId], references: [id], onDelete: Restrict)
  creator        User           @relation(fields: [createdBy], references: [id], onDelete: Restrict)
  reversedMovement StockMovement? @relation("MovementReversal", fields: [reversedMovementId], references: [id], onDelete: Restrict)
  reversal         StockMovement? @relation("MovementReversal")

  @@index([branchId, createdAt(sort: Desc)])
  @@index([branchId, productId, createdAt(sort: Desc)])
  @@index([productId])
  @@index([referenceId])
  @@index([createdBy])
  @@map("stock_movements")
}

model StockTransfer {
  id                  String         @id @default(uuid()) @db.Uuid
  sourceBranchId      String         @map("source_branch_id") @db.Uuid
  destinationBranchId String         @map("destination_branch_id") @db.Uuid
  status              TransferStatus @default(PENDING)
  createdBy           String         @map("created_by") @db.Uuid
  note                String?        @db.VarChar(500)
  completedAt         DateTime?      @map("completed_at") @db.Timestamptz(3)
  completedBy         String?        @map("completed_by") @db.Uuid
  cancelledAt         DateTime?      @map("cancelled_at") @db.Timestamptz(3)
  cancelledBy         String?        @map("cancelled_by") @db.Uuid
  createdAt           DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)

  sourceBranch      Branch              @relation("TransferSource", fields: [sourceBranchId], references: [id], onDelete: Restrict)
  destinationBranch Branch              @relation("TransferDestination", fields: [destinationBranchId], references: [id], onDelete: Restrict)
  creator           User                @relation("TransferCreatedBy", fields: [createdBy], references: [id], onDelete: Restrict)
  items             StockTransferItem[]

  @@index([sourceBranchId, createdAt(sort: Desc)])
  @@index([destinationBranchId, createdAt(sort: Desc)])
  @@index([status])
  @@map("stock_transfers")
}

model StockTransferItem {
  id         String @id @default(uuid()) @db.Uuid
  transferId String @map("transfer_id") @db.Uuid
  productId  String @map("product_id") @db.Uuid
  quantity   Int

  transfer StockTransfer @relation(fields: [transferId], references: [id], onDelete: Cascade)
  product  Product       @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@unique([transferId, productId])
  @@index([productId])
  @@map("stock_transfer_items")
}

model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String?  @map("user_id") @db.Uuid
  action     String   @db.VarChar(80)
  entityType String   @map("entity_type") @db.VarChar(80)
  entityId   String   @map("entity_id") @db.VarChar(64)
  metadata   Json     @default("{}")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId])
  @@index([userId, createdAt(sort: Desc)])
  @@index([createdAt(sort: Desc)])
  @@map("audit_logs")
}

model Notification {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  branchId  String?   @map("branch_id") @db.Uuid
  type      String    @db.VarChar(40)
  title     String    @db.VarChar(200)
  message   String    @db.VarChar(1000)
  readAt    DateTime? @map("read_at") @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  branch Branch? @relation(fields: [branchId], references: [id], onDelete: SetNull)

  @@index([userId, readAt, createdAt(sort: Desc)])
  @@index([branchId])
  @@map("notifications")
}

// Stores the outcome of idempotent write requests. The unique (user_id, key) constraint is
// what makes concurrent duplicates safe: the second insert blocks until the first transaction
// commits or rolls back.
model IdempotencyKey {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String   @map("user_id") @db.Uuid
  key          String   @db.VarChar(128)
  operation    String   @db.VarChar(64)
  requestHash  String   @map("request_hash") @db.VarChar(64)
  responseBody Json     @map("response_body")
  statusCode   Int      @map("status_code")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, key])
  @@index([createdAt])
  @@map("idempotency_keys")
}

// Transactional outbox: rows are written in the same transaction as the business change and
// delivered to Socket.IO by the outbox dispatcher after commit.
model OutboxEvent {
  id            String    @id @default(uuid()) @db.Uuid
  eventName     String    @map("event_name") @db.VarChar(80)
  // Room the event is delivered to, e.g. "branch:<uuid>" or "user:<uuid>". Server-generated only.
  room          String    @db.VarChar(120)
  payload       Json
  attempts      Int       @default(0)
  lastError     String?   @map("last_error") @db.VarChar(1000)
  nextAttemptAt DateTime  @default(now()) @map("next_attempt_at") @db.Timestamptz(3)
  publishedAt   DateTime? @map("published_at") @db.Timestamptz(3)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([publishedAt, nextAttemptAt, createdAt])
  @@map("outbox_events")
}
