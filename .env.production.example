# Production configuration for docker-compose.prod.yml.
# Copy to .env.production (never commit it) and replace every value marked CHANGE ME.
# Always pass it explicitly:  docker compose -f docker-compose.prod.yml --env-file .env.production ...
# (scripts/deploy.sh does this for you).

# --- Public endpoint ------------------------------------------------------
# DNS A/AAAA record of this domain must point at the server before the first start,
# so Caddy can obtain a Let's Encrypt certificate.
# CHANGE ME
API_DOMAIN=api.example.com
# CHANGE ME (certificate expiry notices)
ACME_EMAIL=ops@example.com

# --- Browser clients --------------------------------------------------------
# Exact origin(s) of the frontend, comma-separated. Wildcards are rejected in production.
# CHANGE ME
FRONTEND_ORIGIN=https://app.example.com

# Refresh cookie. COOKIE_SECURE=true is enforced in production.
# Use "strict" when the frontend and API share a registrable domain (app.example.com +
# api.example.com). Use "none" only if they are on unrelated domains.
COOKIE_SECURE=true
COOKIE_SAMESITE=strict

# --- Database ---------------------------------------------------------------
# Use a letters/digits-only password: it is embedded in DATABASE_URL without URL-encoding.
# Generate: openssl rand -hex 24
POSTGRES_USER=stockpulse
POSTGRES_PASSWORD=CHANGE_ME_hex_password
POSTGRES_DB=stockpulse
# Prisma pool size per API instance (keep total below PostgreSQL max_connections).
DB_CONNECTION_LIMIT=10

# --- Auth secrets -----------------------------------------------------------
# Two DIFFERENT values, >= 32 chars. Generate each with: openssl rand -base64 48
JWT_ACCESS_SECRET=CHANGE_ME
JWT_ACCESS_TTL=15m
REFRESH_TOKEN_SECRET=CHANGE_ME
REFRESH_TOKEN_TTL_DAYS=7

# --- Policies ---------------------------------------------------------------
# Public self-registration. Usually false in production: admins create accounts.
ALLOW_REGISTRATION=false
MANAGERS_CAN_MANAGE_PRODUCTS=false

# --- Rate limiting (login / refresh / register) -----------------------------
AUTH_RATE_LIMIT=10
AUTH_RATE_TTL_SECONDS=60

# --- Outbox dispatcher ------------------------------------------------------
OUTBOX_POLL_INTERVAL_MS=1000

# --- Image tag (optional) ---------------------------------------------------
API_IMAGE_TAG=latest
