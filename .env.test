# --- Runtime -------------------------------------------------------------
NODE_ENV=test
PORT=3000
# Comma-separated list of allowed browser origins (CORS + Socket.IO + CSRF origin check).
FRONTEND_ORIGIN=http://localhost:5173
# Set to the number of reverse-proxy hops in production so rate limiting sees real client IPs.
TRUST_PROXY=0

# --- Database ------------------------------------------------------------
DATABASE_URL=postgresql://stockpulse:stockpulse@localhost:5432/stockpulse_test?schema=public

# --- Auth ----------------------------------------------------------------
# Generate each with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=test-access-secret-0123456789abcdef0123456789
JWT_ACCESS_TTL=15m
REFRESH_TOKEN_SECRET=test-refresh-secret-0123456789abcdef012345678
REFRESH_TOKEN_TTL_DAYS=7
# Refresh cookie flags. COOKIE_SECURE must be true in production (HTTPS only).
COOKIE_SECURE=false
COOKIE_SAMESITE=strict
# Allow anyone to self-register (new accounts have no branch access until an admin grants it).
ALLOW_REGISTRATION=true
# Policy switch: let MANAGER members create/edit products and categories.
MANAGERS_CAN_MANAGE_PRODUCTS=false

# --- Rate limiting (login / refresh / register) ---------------------------
AUTH_RATE_LIMIT=1000
AUTH_RATE_TTL_SECONDS=60

# --- Outbox dispatcher ---------------------------------------------------
OUTBOX_POLL_INTERVAL_MS=200
