{
  "name": "stockpulse-backend",
  "version": "1.0.0",
  "description": "StockPulse — real-time multi-branch inventory management backend",
  "private": true,
  "license": "MIT",
  "engines": {
    "node": ">=20.11",
    "npm": ">=11"
  },
  "scripts": {
    "build": "nest build",
    "start": "node dist/main.js",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/main.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint \"{src,test,scripts,examples}/**/*.ts\"",
    "lint:fix": "eslint \"{src,test,scripts,examples}/**/*.ts\" --fix",
    "format": "prettier --write \"{src,test,scripts,examples,prisma}/**/*.ts\"",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "db:seed": "ts-node --transpile-only prisma/seed.ts",
    "test": "jest",
    "test:unit": "jest",
    "test:e2e": "jest --config test/jest-e2e.config.ts --runInBand",
    "test:all": "npm run test:unit && npm run test:e2e",
    "test:cov": "jest --coverage",
    "socket:demo": "ts-node --transpile-only examples/socket-client.ts",
    "build:seed": "tsc prisma/seed.ts prisma/create-admin.ts --outDir dist/seed --rootDir prisma --module commonjs --target ES2023 --esModuleInterop --skipLibCheck",
    "db:seed:compiled": "node dist/seed/seed.js",
    "admin:create": "ts-node --transpile-only prisma/create-admin.ts",
    "admin:create:compiled": "node dist/seed/create-admin.js"
  },
  "prisma": {
    "seed": "ts-node --transpile-only prisma/seed.ts"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.0",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.1.0",
    "@nestjs/jwt": "^11.0.0",
    "@nestjs/platform-express": "^11.1.0",
    "@nestjs/platform-socket.io": "^11.1.0",
    "@nestjs/swagger": "^11.2.0",
    "@nestjs/throttler": "^6.4.0",
    "@nestjs/websockets": "^11.1.0",
    "@prisma/client": "~6.19.0",
    "argon2": "^0.44.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "cookie-parser": "^1.4.7",
    "helmet": "^8.1.0",
    "prisma": "~6.19.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "socket.io": "^4.8.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.30.0",
    "@nestjs/cli": "^11.0.7",
    "@nestjs/schematics": "^11.0.5",
    "@nestjs/testing": "^11.1.0",
    "@types/cookie-parser": "^1.4.9",
    "@types/express": "^5.0.3",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.15.0",
    "@types/supertest": "^6.0.3",
    "eslint": "^9.30.0",
    "eslint-config-prettier": "^10.1.5",
    "globals": "^16.3.0",
    "jest": "^29.7.0",
    "prettier": "^3.6.2",
    "socket.io-client": "^4.8.1",
    "supertest": "^7.1.1",
    "ts-jest": "^29.4.0",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "~5.9.2",
    "typescript-eslint": "^8.35.0"
  },
  "allowScripts": {
    "@prisma/client@6.19.3": true,
    "prisma@6.19.3": true,
    "@prisma/engines@6.19.3": true,
    "argon2@0.44.0": true
  }
}
